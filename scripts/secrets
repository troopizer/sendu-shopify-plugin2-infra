#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

DEFAULT_AWS_PROFILE="sendu"
DEFAULT_SECRET_ID="${APP_SECRET_ID:-}"
AWS_PROFILE_NAME="${DEFAULT_AWS_PROFILE}"
ENVIRONMENT_NAME="${DEPLOY_ENVIRONMENT:-staging}"
ENVIRONMENT_DIR="${DEPLOY_ENVIRONMENT_DIR:-}"
PARAMETERS_FILE="${DEPLOY_PARAMETERS_FILE:-}"
ARG_ENVIRONMENT_SET=false
ARG_ENVIRONMENT_DIR_SET=false
ARG_PARAMETERS_FILE_SET=false
SECRET_ID=""
PARSED_ARGS=()

REQUIRED_KEYS=(
  "UPSTREAM_API_TOKEN"
  "SHOPIFY_API_KEY"
  "SHOPIFY_API_SECRET"
  "RAILS_MASTER_KEY"
  "DB_PASSWORD"
  "DB_USERNAME"
  "SHOPIFY_APP_HOST"
  "SHOPIFY_FRONTEND_URL"
)

usage() {
  cat <<'EOF'
Usage:
  secrets [--environment <name>] [--profile <name>] get [KEY]
  secrets [--environment <name>] [--profile <name>] init
  secrets [--environment <name>] [--profile <name>] ls
  secrets [--environment <name>] [--profile <name>] set <KEY>

Examples:
  printf '%s' 'value' | secrets set DB_USERNAME
  secrets set DB_USERNAME

Environment:
  APP_SECRET_ID             Override default secret id/name
  DEPLOY_ENVIRONMENT        Environment folder/name (default: staging)
  DEPLOY_ENVIRONMENT_DIR    Environment folder (default: DEPLOY_ENVIRONMENT)
  DEPLOY_PARAMETERS_FILE    Parameter file used to resolve AppSecretsSecretId
Options:
  --environment <name>      Environment folder/name (default: DEPLOY_ENVIRONMENT or staging)
  --environment-dir <path>  Environment folder (default: DEPLOY_ENVIRONMENT_DIR or <environment>)
  --profile <name>          AWS CLI profile to use (default: sendu)
  --parameters-file <path>  Parameter file used to resolve AppSecretsSecretId
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

parse_global_args() {
  PARSED_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --environment)
        [[ $# -ge 2 ]] || die "Missing value for --environment"
        [[ -n "$2" ]] || die "Missing value for --environment"
        ENVIRONMENT_NAME="$2"
        ARG_ENVIRONMENT_SET=true
        shift 2
        ;;
      --environment-dir)
        [[ $# -ge 2 ]] || die "Missing value for --environment-dir"
        [[ -n "$2" ]] || die "Missing value for --environment-dir"
        ENVIRONMENT_DIR="$2"
        ARG_ENVIRONMENT_DIR_SET=true
        shift 2
        ;;
      --profile)
        [[ $# -ge 2 ]] || die "Missing value for --profile"
        [[ -n "$2" ]] || die "Missing value for --profile"
        AWS_PROFILE_NAME="$2"
        shift 2
        ;;
      --parameters-file)
        [[ $# -ge 2 ]] || die "Missing value for --parameters-file"
        [[ -n "$2" ]] || die "Missing value for --parameters-file"
        PARAMETERS_FILE="$2"
        ARG_PARAMETERS_FILE_SET=true
        shift 2
        ;;
      --)
        shift
        PARSED_ARGS+=("$@")
        break
        ;;
      -h|--help|help)
        PARSED_ARGS+=("$1")
        shift
        ;;
      --*)
        die "Unknown global option: $1"
        ;;
      *)
        PARSED_ARGS+=("$@")
        break
        ;;
    esac
  done
}

resolve_repo_path() {
  local path="$1"
  if [[ "$path" == /* ]]; then
    printf '%s' "$path"
  else
    printf '%s/%s' "$REPO_ROOT" "$path"
  fi
}

resolve_parameters_file() {
  if [[ -z "${ENVIRONMENT_DIR}" ]]; then
    ENVIRONMENT_DIR="${ENVIRONMENT_NAME}"
  elif [[ "${ARG_ENVIRONMENT_SET}" == "true" && "${ARG_ENVIRONMENT_DIR_SET}" == "false" ]]; then
    ENVIRONMENT_DIR="${ENVIRONMENT_NAME}"
  fi

  ENVIRONMENT_DIR="$(resolve_repo_path "${ENVIRONMENT_DIR}")"

  if [[ -z "${PARAMETERS_FILE}" ]]; then
    PARAMETERS_FILE="${ENVIRONMENT_DIR}/parameters.json"
  elif [[ "${ARG_ENVIRONMENT_SET}" == "true" && "${ARG_PARAMETERS_FILE_SET}" == "false" ]]; then
    PARAMETERS_FILE="${ENVIRONMENT_DIR}/parameters.json"
  else
    PARAMETERS_FILE="$(resolve_repo_path "${PARAMETERS_FILE}")"
  fi
}

resolve_secret_id() {
  if [[ -n "${DEFAULT_SECRET_ID}" ]]; then
    SECRET_ID="${DEFAULT_SECRET_ID}"
    return
  fi

  if [[ -f "${PARAMETERS_FILE}" ]]; then
    require_cmd jq
    SECRET_ID="$(jq -r 'map(select(.ParameterKey == "AppSecretsSecretId"))[0].ParameterValue // empty' "${PARAMETERS_FILE}" 2>/dev/null || true)"
  fi

  SECRET_ID="${SECRET_ID:-sendu/${ENVIRONMENT_NAME}/app-shared}"
}

aws_cli() {
  aws --profile "${AWS_PROFILE_NAME}" "$@"
}

secret_exists() {
  aws_cli secretsmanager describe-secret --secret-id "${SECRET_ID}" >/dev/null 2>&1
}

get_secret_string() {
  aws_cli secretsmanager get-secret-value \
    --secret-id "${SECRET_ID}" \
    --query SecretString \
    --output text
}

validate_json_object() {
  jq -e 'type == "object"' >/dev/null
}

cmd_ls() {
  secret_exists || die "Secret '${SECRET_ID}' does not exist. Run: secrets init"
  get_secret_string | jq -r 'keys[]'
}

cmd_get() {
  local key="${1:-}"
  secret_exists || die "Secret '${SECRET_ID}' does not exist. Run: secrets init"

  if [[ -z "${key}" ]]; then
    get_secret_string | jq .
    return
  fi

  local value
  value="$(get_secret_string | jq -r --arg key "${key}" 'if has($key) then .[$key] else empty end')"
  [[ -n "${value}" ]] || die "Key '${key}' not found in secret '${SECRET_ID}'"
  printf '%s\n' "${value}"
}

cmd_set() {
  local key="${1:-}"
  [[ -n "${key}" ]] || die "Usage: secrets set <KEY>"
  secret_exists || die "Secret '${SECRET_ID}' does not exist. Run: secrets init"

  local value
  if [[ -t 0 ]]; then
    [[ -r /dev/tty ]] || die "Interactive input is unavailable. Provide the value via stdin."

    if ! IFS= read -r -s -p "Enter value for ${key}: " value </dev/tty; then
      printf '\n' >/dev/tty
      die "Failed to read value for '${key}'"
    fi

    printf '\n' >/dev/tty
  else
    value="$(cat)"
  fi

  local current updated
  current="$(get_secret_string)"
  printf '%s' "${current}" | validate_json_object || die "SecretString is not a JSON object"

  updated="$(printf '%s' "${current}" | jq --arg key "${key}" --arg value "${value}" '.[$key] = $value')"

  aws_cli secretsmanager put-secret-value \
    --secret-id "${SECRET_ID}" \
    --secret-string "${updated}" >/dev/null

  printf "Updated key '%s' in secret '%s'.\n" "${key}" "${SECRET_ID}"
}

cmd_init() {
  if secret_exists; then
    printf "Secret '%s' already exists.\n" "${SECRET_ID}"
    return
  fi

  local initial
  initial='{}'
  for k in "${REQUIRED_KEYS[@]}"; do
    initial="$(printf '%s' "${initial}" | jq --arg key "${k}" '.[$key] = ""')"
  done

  aws_cli secretsmanager create-secret \
    --name "${SECRET_ID}" \
    --secret-string "${initial}" >/dev/null

  printf "Created secret '%s' with default keys.\n" "${SECRET_ID}"
}

main() {
  parse_global_args "$@"
  set -- "${PARSED_ARGS[@]}"

  local cmd="${1:-}"
  case "${cmd}" in
    -h|--help|help|"")
      usage
      ;;
    ls)
      require_cmd aws
      require_cmd jq
      resolve_parameters_file
      resolve_secret_id
      shift
      cmd_ls "$@"
      ;;
    get)
      require_cmd aws
      require_cmd jq
      resolve_parameters_file
      resolve_secret_id
      shift
      cmd_get "$@"
      ;;
    set)
      require_cmd aws
      require_cmd jq
      resolve_parameters_file
      resolve_secret_id
      shift
      cmd_set "$@"
      ;;
    init)
      require_cmd aws
      require_cmd jq
      resolve_parameters_file
      resolve_secret_id
      shift
      cmd_init "$@"
      ;;
    *)
      usage
      die "Unknown command: ${cmd}"
      ;;
  esac
}

main "$@"
